<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <!--#region  استایل برای  UserControl-->

    <Style TargetType="{x:Type UserControl}">
        <Setter Property="FontFamily" Value="{Binding RelativeSource={RelativeSource Mode=FindAncestor, 
            AncestorType={x:Type Window}}, Path=FontFamily}" />
        <Setter Property="FontSize" Value="{Binding RelativeSource={RelativeSource Mode=FindAncestor, 
            AncestorType={x:Type Window}}, Path=FontSize}" />
        <Setter Property="Background" Value="{DynamicResource UserControl_Background}"/>
    </Style>

    <!--#endregion-->


</ResourceDictionary>