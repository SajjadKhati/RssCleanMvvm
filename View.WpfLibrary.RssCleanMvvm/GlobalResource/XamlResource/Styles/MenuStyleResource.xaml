<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <!--#region  استایل برای ContextMenu و MenuItem-->


    <!--#region  استایل برای Menu-->

    <!--  منظور از FindAncestor ئه Control در FontFamily ، این هست که به اولین شی کنترل والدش رجوع کند و از فونت آن استفاده کند . 
    که معمولا آن کنترل هم مقدار پروپرتیِ FontFamily اش را از کنترل Window میگیرد مگر اینکه در کنترل فرزندِ Window ، تغییر کند .  -->
    <Style TargetType="{x:Type Menu}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="5, 2"/>
        <Setter Property="Background" Value="{DynamicResource MenuBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource MenuForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Menu_BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{Binding RelativeSource={RelativeSource Mode=FindAncestor, 
            AncestorType={x:Type Control}}, Path=FontFamily}"/>
        <Setter Property="FontSize" Value="{Binding RelativeSource={RelativeSource Mode=FindAncestor, 
            AncestorType={x:Type Control}}, Path=FontSize}"/>
        <Setter Property="FontStyle" Value="{Binding RelativeSource={RelativeSource Mode=FindAncestor, 
            AncestorType={x:Type Control}}, Path=FontStyle}"/>
        <Setter Property="FontWeight" Value="{Binding RelativeSource={RelativeSource Mode=FindAncestor, 
            AncestorType={x:Type Control}}, Path=FontWeight}"/>
        <Setter Property="FontStretch" Value="{Binding RelativeSource={RelativeSource Mode=FindAncestor, 
            AncestorType={x:Type Control}}, Path=FontStretch}"/>
        <Setter Property="Template" Value="{DynamicResource MenuTemplate}"/>
    </Style>

    <!--#endregion-->



    <!--#region  استایل برای Menu و ContextMenu-->

    <!--#region  استایل برای ContextMenu-->


    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Padding" Value="5, 2"/>
        <Setter Property="FlowDirection" Value="{Binding Source={x:Static Application.Current}, Path=MainWindow.FlowDirection}"/>
        <Setter Property="Background" Value="{DynamicResource ContextMenu_DefaultBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ContextMenu_And_MenuItem_DefaultForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ContextMenu_DefaultBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="FontFamily" Value="{Binding RelativeSource={RelativeSource Mode=Self}, 
            Path=PlacementTarget.FontFamily, 
            FallbackValue={StaticResource DefaultCommonFontFamily}, 
            TargetNullValue={StaticResource DefaultCommonFontFamily}}"/>
        <Setter Property="FontSize" Value="{Binding RelativeSource={RelativeSource Mode=Self}, 
            Path=PlacementTarget.FontSize,
            FallbackValue={StaticResource DefaultCommonFontSize}, 
            TargetNullValue={StaticResource DefaultCommonFontSize}}"/>
        <Setter Property="FontStyle" Value="{Binding RelativeSource={RelativeSource Mode=Self}, 
            Path=PlacementTarget.FontStyle,
            FallbackValue={StaticResource DefaultCommonFontStyle}, 
            TargetNullValue={StaticResource DefaultCommonFontStyle}}"/>
        <Setter Property="FontWeight" Value="{Binding RelativeSource={RelativeSource Mode=Self}, 
            Path=PlacementTarget.FontWeight,
            FallbackValue={StaticResource DefaultCommonFontWeight}, 
            TargetNullValue={StaticResource DefaultCommonFontWeight}}"/>
        <Setter Property="FontStretch" Value="{Binding RelativeSource={RelativeSource Mode=Self}, 
            Path=PlacementTarget.FontStretch,
            FallbackValue={StaticResource DefaultCommonFontStretch}, 
            TargetNullValue={StaticResource DefaultCommonFontStretch}}"/>
        <Setter Property="Template" Value="{DynamicResource ContextMenuTemplate}"/>
    </Style>


    <!--#endregion-->




    <!--#region  استایل برای Separator -->


    <!--  مقدارِ استاتیکِ MenuItem.SeparatorStyleKey ، مقداری از نوع ResourceKey هست .
    و کلیدی برای زمانی که اعضایی که در MenuItem بکار برده میشه ، از نوعِ کنترل Separator باشن ، استفاده میشه .
    این مقدار فقط get شدنی و خواندنی هست .

    بنابراین در هر جایی که درون MenuItem ، از کنترلِ Separator استفاده کنیم ، استایلِ زیر که برای کنترلِ Separator نوشتیم ، برای اون کنترلِ Separator ای که درونِ MenuItem استفاده شد ، بکار میره .
    -->

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="Template" Value="{DynamicResource MenuItem_SeparatorControlTemplate}" />
    </Style>

    <!--#endregion-->




    <!--#region  استایل برای MenuItem  -->

    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="Background" Value="{DynamicResource MenuItem_DefaultBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource MenuItem_DefaultForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MenuItem_MouseEnterBorderBrush}" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{DynamicResource MenuItem_TopLevelHeaderTemplate}" />
                <Setter Property="Grid.IsSharedSizeScope" Value="true" />
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Template" Value="{StaticResource MenuItem_TopLevelItemTemplate}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource MenuItem_SubmenuHeaderTemplate}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{StaticResource MenuItem_SubmenuItemTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--#endregion-->


    <!--#endregion-->


    <!--#endregion-->


</ResourceDictionary>