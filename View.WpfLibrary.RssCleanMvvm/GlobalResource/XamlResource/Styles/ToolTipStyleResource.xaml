<ResourceDictionary x:Class="View.WpfLibrary.RssCleanMvvm.GlobalResource.XamlResource.Styles.ToolTipStyleResource"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--#region  استایل برای ToolTip-->

    <!--  مقداری که برای پروپرتی FallbackValue تنظیم میشود برای زمانی بکار میرود و برگردانده میشود که Binding به دلایلی مثل-
    عدم وجود پروپرتیِ Source Property و غیره ، خطا بدهد . البته بجز خطای Null بودن مقدار بایندینگ که وظیفه اش با پروپرتی TargetNullValue هست .  -->

    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Padding" Value="10,15,10,10"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource ToolTip_Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource ToolTip_DefaultForeground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ToolTip_DefaultBorderBrush}"/>
        <!-- از PlacementTarget (محلی، والد) -->
        <Setter Property="FlowDirection" Value="{Binding RelativeSource={RelativeSource Self},
            Path=PlacementTarget.FlowDirection, FallbackValue=RightToLeft, TargetNullValue=RightToLeft}"/>
        <Setter Property="FontFamily" Value="{Binding RelativeSource={RelativeSource Self},
            Path=PlacementTarget.FontFamily, FallbackValue={StaticResource DefaultCommonFontFamily},
                TargetNullValue={StaticResource DefaultCommonFontFamily}}"/>
        <Setter Property="FontSize" Value="{Binding RelativeSource={RelativeSource Self},
            Path=PlacementTarget.FontSize, FallbackValue={StaticResource DefaultCommonFontSize},
                TargetNullValue={StaticResource DefaultCommonFontSize}}"/>
        <Setter Property="Template" Value="{DynamicResource ToolTipTemplate}"/>

        <EventSetter Event="Opened" Handler="ToolTip_Opened"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Placement,
                Converter={StaticResource ToolTipsPlacement_ValueConverter}}" Value="true">
                <Setter Property="Padding" Value="10,8,10,10"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--#endregion-->


</ResourceDictionary>