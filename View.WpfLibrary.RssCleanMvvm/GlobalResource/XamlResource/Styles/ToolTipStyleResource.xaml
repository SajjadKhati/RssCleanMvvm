<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--#region  استایل برای ToolTip-->

    <!--  مقداری که برای پروپرتی FallbackValue تنظیم میشود برای زمانی بکار میرود و برگردانده میشود که Binding به دلایلی مثل-
    عدم وجود پروپرتیِ Source Property و غیره ، خطا بدهد . البته بجز خطای Null بودن مقدار بایندینگ که وظیفه اش با پروپرتی TargetNullValue هست .  -->

    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Padding" Value="10,15,10,10"/>
        <Setter Property="FlowDirection" Value="{Binding Source={x:Static Application.Current}, Path=MainWindow.FlowDirection}"/>
        <Setter Property="FontFamily" Value="{Binding RelativeSource={RelativeSource Mode=Self}, 
            Path=PlacementTarget.FontFamily ,
            FallbackValue={StaticResource DefaultCommonFontFamily},
            TargetNullValue={StaticResource DefaultCommonFontFamily}}"/>
        <Setter Property="FontSize" Value="{Binding RelativeSource={RelativeSource Mode=Self}, Path=PlacementTarget.FontSize,
            FallbackValue={StaticResource DefaultCommonFontSize}, 
            TargetNullValue={StaticResource DefaultCommonFontSize}}"/>
        <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource Mode=Self}, 
            Path=PlacementTarget.Foreground ,
            FallbackValue={StaticResource ToolTip_DefaultForeground},
            TargetNullValue={StaticResource ToolTip_DefaultForeground}}"/>
        <Setter Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource Mode=Self}, 
            Path=PlacementTarget.Foreground ,
            FallbackValue={StaticResource ToolTip_DefaultBorderBrush},
            TargetNullValue={StaticResource ToolTip_DefaultBorderBrush}}"/>
        <Setter Property="Background" Value="{StaticResource ToolTip_Background}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template" Value="{StaticResource ToolTipTemplate}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=Placement, 
                    Converter={StaticResource ToolTipsPlacement_ValueConverter}}" Value="true">
                <Setter Property="Padding" Value="10,8,10,10"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--#endregion-->


</ResourceDictionary>