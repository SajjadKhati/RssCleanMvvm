<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <!--#region  استایل دکمه ی شفاف حاشیه دار با کلید خصوصی -->


    <Style x:Key="BorderedButtonStyleKey" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource BorderedButton_Background}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderedButton_BorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource BorderedButton_Foreground}" />
        <Setter Property="Padding" Value="10,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Template" Value="{DynamicResource BorderedButtonControlTemplateKey}" />
    </Style>


    <!--#endregion-->


</ResourceDictionary>