<Window x:Class="View.WpfLibrary.RssCleanMvvm.Elements.Windows.MainWindowView.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View.WpfLibrary.RssCleanMvvm.Elements.Windows.MainWindowView" 
        xmlns:interaction="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:rssusercontrolview="clr-namespace:View.WpfLibrary.RssCleanMvvm.Elements.UserControls.RssUserControlView"
        xmlns:viewModelModules="clr-namespace:ViewModel.ViewModelModules.MainWindowViewModelModule.Class;assembly=ViewModel"
        xmlns:appearanceSwitcherDataModel="clr-namespace:ViewModel.Contracts.ViewContracts.AppearanceSwitcher.DataModel;assembly=ViewModel"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance d:Type=viewModelModules:MainWindowViewModel, IsDesignTimeCreatable=False}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resource/MainWindowResource.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <interaction:Interaction.Triggers>
        <interaction:EventTrigger EventName="Closing">
            <interaction:InvokeCommandAction  Command="{Binding Path=ExitCommand}"/>
        </interaction:EventTrigger>
    </interaction:Interaction.Triggers>

    <Grid FlowDirection="RightToLeft">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="پرونده">
                <MenuItem Header="خروج" ToolTip="خروج از برنامه" Click="ExitMenuItem_Click"/>
            </MenuItem>

            <MenuItem DataContext="{Binding Path=RssUserControlViewModel}" Header="خبر خوان">
                <!-- FallbackValue=False برای وقتی است که مسیر Binding قابل حل نباشد.
                    مثلاً وقتی SelectedRssSiteViewModel برابر null باشد، WPF مقدار UnsetValue
                    برمی‌گرداند (نه null). در این حالت Converter اصلاً صدا زده نمی‌شود و
                    مقدار FallbackValue استفاده می‌شود.

                    بدون FallbackValue: UnsetValue به Converter می‌رود و چون null نیست،
                    نتیجه true برمی‌گردد و MenuItem اشتباهاً فعال می‌ماند.
                -->
                <MenuItem Header="دریافت اخبار جدید" ToolTip="به روزرسانی اخبار جدید از وب"
                          Command="{Binding Path=SelectedRssSiteViewModel.SelectedRssFeedViewModel.DownLoadRssItemsCommand}"
                          IsEnabled="{Binding Path=SelectedRssSiteViewModel.SelectedRssFeedViewModel, 
                                Converter={StaticResource NullableToBoolValueConverterKey}, 
                                    FallbackValue=false}"/>

                <MenuItem Header="ذخیره همه" ToolTip="ذخیره همه ی آیتم های ذخیره نشده"/>
            </MenuItem>

            <MenuItem Header="تنظیمات">
                <MenuItem Header="حالت رنگی">
                    <!-- x:Static برای دسترسی به اعضای static یک کلاس استفاده میشود.
                        اعضای enum در C# همیشه static هستند (مثلاً ThemeName.Dark).
                        بنابراین برای فرستادن مقدار enum به عنوان CommandParameter،
                        از x:Static استفاده میکنیم:
                            CommandParameter="{x:Static local:ThemeName.Dark}"

                        نکته: خود enum یک نوع است، ولی هر عضو آن یک مقدار ثابت (static) است.
                        پس x:Static اینجا یعنی "مقدار ثابت Dark از نوع ThemeName". -->
                    <MenuItem Header="تاریک" ToolTip="تم تاریک" 
                              Command="{Binding Path=ChangeThemeCommand}"
                              CommandParameter="{x:Static appearanceSwitcherDataModel:ThemeName.Dark}"/>

                    <MenuItem Header="روشن" ToolTip="تم روشن"
                          Command="{Binding Path=ChangeThemeCommand}"
                          CommandParameter="{x:Static appearanceSwitcherDataModel:ThemeName.Light}"/>
                </MenuItem>
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1" Margin="0, 10, 0, 0">
            <rssusercontrolview:RssUserControl/>
        </Grid>

        <Grid Grid.Row="2" Margin="10, 0">
            <!-- NotifyOnTargetUpdated را در Binding زیر وقتی true کنیم ، باعث میشه که رویداد Binding.TargetUpdated اجرا بشه . 
            بصورت پیش فرض ، یا اگه NotifyOnTargetUpdated برابر false باشه ، بخاطر دلایل کارایی در برنامه ، اجرا نمیشه .
            
            این رویداد ، یک Routed Event هست . و این یعنی هندلرِ این رویداد را هم در شیِ Binding ای که انجام دادیم (شی Binding در زیر که برای Text ئه TextBlock انجام دادیم) در دسترس هست و یعنی -
            میشه هندلرش را اینجا به دست آورد و تنظیم کرد ؛ 
            و همچنین چون Routed Event ها ، در کنترل های والد ، پیمایش میکنند ، در کنترل های والدی که این Binding را انجام دادیم (تا MainWindow) هم قابل دستیابی و تنظیم هندلر این رویداد هست .
            
            این رویداد هم زمانی که Binding Target Property تغییر کنه (در اینجا ، پروپرتی Text در TextBlock تغییر کنه) ، اجرا میشه .
            در استایلِ این TextBlockو در  TextBlock.Triggers اش ، زمانی که این رویداد (Binding.TargetUpdated) اجرا شد ، برای انیمیشن ، استفاده کردیم .
            -->
            <TextBlock VerticalAlignment="Top" Text="{Binding Path=StatusMessage, NotifyOnTargetUpdated=True}"
                       Style="{StaticResource StatusBarTexBlockStyle}">
            </TextBlock>

        </Grid>
    </Grid>
    
</Window>
