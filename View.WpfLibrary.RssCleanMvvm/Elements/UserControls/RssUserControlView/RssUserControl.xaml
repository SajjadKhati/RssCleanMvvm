<UserControl x:Class="View.WpfLibrary.RssCleanMvvm.Elements.UserControls.RssUserControlView.RssUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:View.WpfLibrary.RssCleanMvvm.Elements.UserControls.RssUserControlView"
             xmlns:viewModelModules="clr-namespace:ViewModel.ViewModelModules.RssUserControlViewModelModule.Class;assembly=ViewModel"
             xmlns:interaction="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance d:Type=viewModelModules:RssUserControlViewModel, IsDesignTimeCreatable=False}"
             DataContext="{Binding Path=RssUserControlViewModel}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resource/RssUserControlResource.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <interaction:Interaction.Triggers>
        <interaction:EventTrigger EventName="Loaded">
            <interaction:InvokeCommandAction  Command="{Binding Path=LoadRssSiteCommand}"/>
        </interaction:EventTrigger>
    </interaction:Interaction.Triggers>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0, 5">
                <TextBlock HorizontalAlignment="Left" Text="{DynamicResource NewsSiteKey}" Style="{StaticResource TextBlockStyleKey}"/>

                <ComboBox  x:Name="SiteNameComboBox"  HorizontalAlignment="Right" HorizontalContentAlignment="Center" MinWidth="250" IsReadOnly="True"
                       Text="{DynamicResource SelectNewsAgencyKey}" IsSynchronizedWithCurrentItem="True"
                       ItemsSource="{Binding Path=RssSiteViewModels }"
                       DisplayMemberPath="SiteName"
                       SelectedItem="{Binding Mode=OneWayToSource, Path=SelectedRssSiteViewModel}"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0, 5">
                <TextBlock HorizontalAlignment="Left" Text="{DynamicResource NewsCategoryKey}" Style="{StaticResource TextBlockStyleKey}"/>

                <ComboBox HorizontalAlignment="Right" HorizontalContentAlignment="Center"  MinWidth="250" IsReadOnly="True" 
                        Text="{DynamicResource SelectNewsCategoryKey}"
                      ItemsSource="{Binding  Path=RssSiteViewModels/RssFeedViewModels}"
                      DisplayMemberPath="Title"
                      SelectedItem="{Binding Mode=OneWayToSource, Path=RssSiteViewModels/SelectedRssFeedViewModel}"
                      IsEnabled="{Binding Path=SelectedRssSiteViewModel, 
                            Converter={StaticResource NullableToBoolValueConverterKey} }"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="1" Margin="10">
            <ListBox ItemsSource="{Binding Path=SelectedRssSiteViewModel.SelectedRssFeedViewModel.RssItemViewModels}"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" 
                     VirtualizingPanel.CacheLength="1,1" VirtualizingPanel.CacheLengthUnit="Page"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VerticalContentAlignment="Center"
                     ItemTemplate="{StaticResource RssItemDataTemplateKey}"/>
        </Grid>
    </Grid>
    
</UserControl>
